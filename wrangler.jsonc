// Cloudflare Worker (assets estáticos) do Aura Pad.
// A cada push no main o Cloudflare publica os arquivos desta pasta.
{
  "name": "aura-pad",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
